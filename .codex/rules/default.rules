# it-tools-guidebook で Codex に許す命令。
#
# 仕様は https://learn.chatgpt.com/docs/agent-configuration/rules と
# codex-rs/execpolicy/README.md にある。要点は次のとおり。
#
#   - 読み込み先は Team Config、~/.codex/rules/、<リポジトリ>/.codex/rules/ の3層。
#     リポジトリ側は、その層が信頼されているときだけ読まれる。
#   - decision は allow / prompt / forbidden。既定は allow。
#     複数が当たったときは最も厳しいものを採る（forbidden > prompt > allow）。
#   - pattern の各要素は文字列か、代替を並べたリストにできる。
#   - match と not_match は読み込み時に検査される単体試験である。外れると読み込みが失敗する。
#     文字列で書くと shlex で分解される。
#   - forbidden には、代わりに何をすればよいかを justification に書く。
#   - bash -c の中身は && || ; | で分けて評価される。変数展開や入出力の切り替えを
#     含むものは、分けずに1つの呼び出しとして扱われる。
#
# 確かめ方:
#   codex execpolicy check --pretty --rules .codex/rules/default.rules -- bash tools/doclint.sh
# 当てはまる規則が無い命令は {"matchedRules": []} を返し、通常の承認へ落ちる。

# 絶対経路で呼ばれても下の規則が当たるようにする。
host_executable(name = "git", paths = ["/usr/bin/git"])
host_executable(name = "docker", paths = ["/usr/bin/docker"])
host_executable(name = "bash", paths = ["/usr/bin/bash", "/bin/bash"])

# --- このリポジトリの検査 ---

prefix_rule(
    pattern = ["bash", "tools/doclint.sh"],
    decision = "allow",
    justification = "文書の検査。Docker の中で動き、リポジトリを読むだけである",
    match = ["bash tools/doclint.sh", "bash tools/doclint.sh README.md"],
    not_match = ["bash tools/agy.sh --why-denied"],
)

prefix_rule(
    pattern = ["docker", "build", "-t", "edocs-tools"],
    decision = "allow",
    justification = "検査に使う作業用イメージを作る。像の名前を固定している",
    match = ["docker build -t edocs-tools -f standards/engineering-docs-standard/tools/Dockerfile standards/engineering-docs-standard/tools/"],
    not_match = ["docker build -t other-image ."],
)

# --- 読み取りだけの命令 ---

prefix_rule(
    pattern = [["ls", "cat", "head", "tail", "wc", "stat", "file", "find", "rg", "realpath"]],
    decision = "allow",
    justification = "ファイルを読むだけである",
    match = ["cat README.md", "rg doclint tools/", "wc -l AGENTS.md"],
    not_match = ["rm -rf /tmp/x", "curl https://example.com"],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "rev-parse", "ls-files", "submodule"]],
    decision = "allow",
    justification = "作業ツリーを読むだけである。履歴も作業ツリーも変えない",
    match = ["git status --short", "git log --oneline -5", "git submodule status"],
    not_match = ["git push origin main", "git add ."],
)

# --- 確認を求める命令 ---

prefix_rule(
    pattern = ["git", ["add", "commit", "checkout", "switch", "restore"]],
    decision = "prompt",
    justification = "履歴か作業ツリーを変える。人の判断を挟む",
    match = ["git add .", "git commit -m 'docs: 直す'"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["docker", "run"],
    decision = "prompt",
    justification = "任意の像を走らせられる。検査用の呼び出しは bash tools/doclint.sh 側で許す",
    match = ["docker run --rm edocs-tools python tools/doclint.py"],
    not_match = ["docker build -t edocs-tools ."],
)

# シェルで包んだ呼び出しについて
#
# codex execpolicy check では bash -c "git push origin main" がどの規則にも当たらない。
# しかし実行時は違う。Codex は /bin/bash -lc '<命令>' に包んだうえで中身を取り出して
# 判定する。2026-09-01 に実測した。
#   git clean -n  -> 下の forbidden が当たり、justification を添えて拒否された
#   git status --short -> 上の allow が当たり、確認なしで実行された
# したがって包み方を狙った規則は要らない。中身に対する規則だけを書けばよい。

# --- 禁じる命令 ---

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "公開先へ送る操作は人が行う。変更を渡すときは、コミットまでを済ませて人へ伝える",
    match = ["git push origin main"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "作業中の変更を戻せない形で捨てる。特定のファイルだけ戻すなら git restore <経路> を使う",
    match = ["git reset --hard HEAD"],
    not_match = ["git log"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡のファイルを消す。research/ の調査パックが失われる。消す対象を確かめるなら git status --short を使う",
    match = ["git clean -fd"],
    not_match = ["git status"],
)
